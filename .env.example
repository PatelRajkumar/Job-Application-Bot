# ─── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
ALLOWED_USER_ID=your_telegram_numeric_user_id

# ─── Gemini API ───────────────────────────────────────────────────────────────
# Get free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Google Drive ─────────────────────────────────────────────────────────────
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Run `node upload_to_drive.js --setup` to generate this token
GOOGLE_REFRESH_TOKEN=your_refresh_token_from_oauth_setup

# The ID from your Google Drive folder URL:
# https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
DRIVE_FOLDER_ID=your_google_drive_folder_id

# ─── Server (set automatically by Render, leave as-is locally) ────────────────
PORT=8080

# ─── Email Finder APIs ────────────────────────────────────────────────────────
# Layer 1: tomba.io/register — 75 signup credits + ~25-50/month free
TOMBA_API_KEY=your_tomba_api_key
TOMBA_API_SECRET=your_tomba_api_secret
# Layer 2: snov.io — 50 free trial credits (requires client_id + client_secret)
SNOV_CLIENT_ID=your_snov_client_id
SNOV_CLIENT_SECRET=your_snov_client_secret
# Layers 3-4: hunter.io — 50 unified credits/month, resets monthly
HUNTER_API_KEY=your_hunter_api_key
# Layer 5: zerobounce.net — 100 free SMTP verifications/month (use business email to sign up)
ZEROBOUNCE_KEY=your_zerobounce_api_key

# ─── Supabase Analytics (Optional, but recommended) ───────────────────────────
SUPABASE_DB_URL=postgres://user:password@host:port/postgres
